        "intro": "Abundantes possuem duas ou mais formas equivalentes. Pronominais conjugam-se com pronome pessoal.",
        "xpReward": 50,
        "coinReward": 14,
        "requiredCorrectRatio": 1,
        "questions": [
          {
            "id": "abu-q1",
            "type": "single-choice",
            "prompt": "O que é um verbo abundante?",
            "choices": [
              { "id": "a", "label": "Possui duas ou mais formas equivalentes, como imprimido e impresso." },
              { "id": "b", "label": "Não possui infinitivo." },
              { "id": "c", "label": "Só é usado no plural." }
            ],
            "correctChoiceId": "a",
            "explanation": "As formas abundantes convivem com o mesmo valor."
          },
          {
            "id": "abu-q2",
            "type": "single-choice",
            "prompt": "Qual verbo é abundante?",
            "choices": [
              { "id": "a", "label": "falar" },
              { "id": "b", "label": "imprimir" },
              { "id": "c", "label": "partir" }
            ],
            "correctChoiceId": "b",
            "explanation": "Imprimir admite imprimido e impresso."
          },
          {
            "id": "abu-q3",
            "type": "multiple-choice",
            "prompt": "Quais verbos são pronominais?",
            "choices": [
              { "id": "a", "label": "arrepender-se" },
              { "id": "b", "label": "queixar-se" },
              { "id": "c", "label": "falar" },
              { "id": "d", "label": "lembrar-se" }
            ],
            "correctChoiceIds": ["a", "b", "d"],
            "explanation": "Verbos pronominais conjugam-se com pronome reflexivo."
          }
        ]
      }
    },
    {
      "id": "verbos-auxiliares-principais-vicarios",
      "title": "Auxiliares, Principais e Vicários",
      "subtitle": "Quem ajuda, quem manda e quem substitui",
      "chapter": "Módulo 03 · Função",
      "icon": "npc",
      "position": { "x": 0, "y": 0 },
      "unlock": { "requires": ["verbos-abundantes-pronominais"] },
      "npc": {
        "speaker": "Sentinela da Oração",
        "lines": [
          "Nem todo verbo carrega sozinho o sentido da oração.",
          "Vamos entender os papéis de cada um."
        ]
      },
      "reward": { "itemId": "selo-funcao", "label": "Selo da função verbal" },
      "lesson": {
        "id": "lesson-verbos-auxiliares-principais-vicarios",
        "title": "Verbos auxiliares, principais e vicários",
        "intro": "Auxiliares formam locuções; principais são o núcleo do predicado; vicários substituem outro verbo.",
        "xpReward": 55,
        "coinReward": 15,
        "requiredCorrectRatio": 1,
        "questions": [
          {
            "id": "aux-q1",
            "type": "single-choice",
            "prompt": "Qual é a função do verbo auxiliar?",
            "choices": [
              { "id": "a", "label": "Formar tempos compostos e locuções verbais, como em 'tenho estudado'." },
              { "id": "b", "label": "Ser sempre o núcleo do predicado." },
              { "id": "c", "label": "Substituir o sujeito da oração." }
            ],
            "correctChoiceId": "a",
            "explanation": "Em 'tenho estudado', 'tenho' auxilia 'estudado'."
          },
          {
            "id": "aux-q2",
            "type": "single-choice",
            "prompt": "O que é um verbo principal?",
            "choices": [
              { "id": "a", "label": "É o núcleo do predicado e carrega o sentido da ação ou estado." },
              { "id": "b", "label": "Só aparece em locuções verbais." },
              { "id": "c", "label": "Indica apenas tempo." }
            ],
            "correctChoiceId": "a",
            "explanation": "O principal carrega a carga semântica central do predicado."
          },
          {
            "id": "aux-q3",
            "type": "single-choice",
            "prompt": "O que é um verbo vicário?",
            "choices": [
              { "id": "a", "label": "Substitui outro verbo já mencionado, como 'fazer' em 'Ele estuda e eu também o faço'." },
              { "id": "b", "label": "Nunca aparece em orações." },
              { "id": "c", "label": "É sempre irregular." }
            ],
            "correctChoiceId": "a",
            "explanation": "O vicário evita repetir o verbo anterior."
          }
        ]
      }
    },
    {
      "id": "verbos-causativos-sensitivos",
