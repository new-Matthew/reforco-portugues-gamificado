  "nodes": [
    {
      "id": "verbos-terminalidade-ar",
      "title": "1ª conjugação (-AR)",
      "subtitle": "Amar, falar, pular...",
      "chapter": "Módulo 01 · Terminação",
      "icon": "npc",
      "position": { "x": 0, "y": 0 },
      "unlock": { "requires": [] },
      "npc": {
        "speaker": "Mestre Verbo",
        "lines": [
          "Bem-vindo à Trilha dos Verbos!",
          "Hoje vamos reconhecer a 1ª conjugação pela terminação -AR."
        ]
      },
      "reward": { "itemId": "selo-ar", "label": "Selo da 1ª conjugação" },
      "lesson": {
        "id": "lesson-verbos-ar",
        "title": "Verbos terminados em -AR",
        "intro": "Na 1ª conjugação, o infinitivo termina em -AR. A vogal temática é -a-.",
        "xpReward": 40,
        "coinReward": 10,
        "requiredCorrectRatio": 1,
        "questions": [
          {
            "id": "ar-q1",
            "type": "single-choice",
            "prompt": "Qual verbo pertence à 1ª conjugação?",
            "choices": [
              { "id": "a", "label": "vender" },
              { "id": "b", "label": "amar" },
              { "id": "c", "label": "proibir" }
            ],
            "correctChoiceId": "b",
            "explanation": "Amar termina em -AR, por isso é da 1ª conjugação."
          },
          {
            "id": "ar-q2",
            "type": "multiple-choice",
            "prompt": "Quais verbos terminam em -AR?",
            "choices": [
              { "id": "a", "label": "falar" },
              { "id": "b", "label": "correr" },
              { "id": "c", "label": "pular" },
              { "id": "d", "label": "partir" }
            ],
            "correctChoiceIds": ["a", "c"],
            "explanation": "Falar e pular terminam em -AR. Correr é -ER e partir é -IR."
          },
          {
            "id": "ar-q3",
            "type": "text",
            "prompt": "Complete: os verbos terminados em -AR pertencem à ___ conjugação.",
            "placeholder": "Ex.: 1ª",
            "acceptedAnswers": ["1ª", "1a", "1", "primeira", "primeira conjugação", "1ª conjugação"],
            "explanation": "A vogal temática -a- caracteriza a 1ª conjugação."
          }
        ]
      }
    },
    {
      "id": "verbos-terminalidade-er-or",
      "title": "2ª conjugação (-ER e -OR)",
      "subtitle": "Fazer, vender, pôr...",
      "chapter": "Módulo 01 · Terminação",
      "icon": "star",
      "position": { "x": 2, "y": 1 },
      "unlock": { "requires": ["verbos-terminalidade-ar"] },
      "npc": {
        "speaker": "Mestre Verbo",
        "lines": [
          "A 2ª conjugação reúne os verbos em -ER e também os em -OR.",
          "Cuidado: pôr, compor e repor entram nessa turma!"
        ]
      },
      "reward": { "itemId": "selo-er-or", "label": "Selo da 2ª conjugação" },
      "lesson": {
        "id": "lesson-verbos-er-or",
        "title": "Verbos terminados em -ER e -OR",
        "intro": "A 2ª conjugação tem vogal temática -e-, com infinitivos em -ER e -OR.",
        "xpReward": 45,
        "coinReward": 12,
        "requiredCorrectRatio": 1,
        "questions": [
          {
            "id": "er-q1",
            "type": "single-choice",
            "prompt": "Qual verbo pertence à 2ª conjugação?",
            "choices": [
              { "id": "a", "label": "amar" },
              { "id": "b", "label": "fazer" },
              { "id": "c", "label": "proibir" }
            ],
            "correctChoiceId": "b",
            "explanation": "Fazer termina em -ER, portanto é da 2ª conjugação."
          },
          {
            "id": "er-q2",
            "type": "multiple-choice",
            "prompt": "Quais verbos são da 2ª conjugação?",
            "choices": [
              { "id": "a", "label": "vender" },
              { "id": "b", "label": "pôr" },
              { "id": "c", "label": "partir" },
              { "id": "d", "label": "correr" }
            ],
            "correctChoiceIds": ["a", "b", "d"],
            "explanation": "Vender e correr terminam em -ER; pôr termina em -OR. Partir é -IR."
          },
          {
            "id": "er-q3",
            "type": "single-choice",
            "prompt": "Por que 'pôr' é classificado na 2ª conjugação?",
            "choices": [
              { "id": "a", "label": "Porque termina em -OR, terminação associada à 2ª conjugação." },
              { "id": "b", "label": "Porque termina em -AR." },
              { "id": "c", "label": "Porque não possui conjugação." }
            ],
            "correctChoiceId": "a",
            "explanation": "Além de -ER, a terminação -OR (pôr, compor, repor) integra a 2ª conjugação."
          }
        ]
      }
    },
