          },
          {
            "id": "cau-q3",
            "type": "multiple-choice",
            "prompt": "Quais verbos são causativos?",
            "choices": [
              { "id": "a", "label": "mandar" },
              { "id": "b", "label": "deixar" },
              { "id": "c", "label": "estudar" },
              { "id": "d", "label": "fazer" }
