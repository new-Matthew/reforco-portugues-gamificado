    {
      "id": "verbos-regulares-irregulares",
      "title": "Regulares e Irregulares",
      "subtitle": "Modelo fixo versus mudanças no radical",
      "chapter": "Módulo 02 · Conjugação",
      "icon": "npc",
      "position": { "x": 2, "y": 0 },
      "unlock": { "requires": ["verbos-terminalidade-ir"] },
      "npc": {
        "speaker": "Guardiã das Formas",
        "lines": [
          "Nem todo verbo segue o modelo à risca.",
          "Vamos separar os regulares dos irregulares."
        ]
      },
      "reward": { "itemId": "lupa-regular", "label": "Lupa do regular" },
      "lesson": {
        "id": "lesson-verbos-regulares-irregulares",
        "title": "Verbos regulares e irregulares",
        "intro": "Regulares mantêm o radical e as terminações do modelo. Irregulares alteram o radical ou as terminações.",
        "xpReward": 50,
        "coinReward": 14,
        "requiredCorrectRatio": 1,
        "questions": [
          {
            "id": "reg-q1",
            "type": "single-choice",
            "prompt": "O que caracteriza um verbo regular?",
            "choices": [
              { "id": "a", "label": "Mantém o radical e segue as terminações do modelo de sua conjugação." },
              { "id": "b", "label": "Muda o radical em todas as pessoas." },
              { "id": "c", "label": "Só existe no singular." }
            ],
            "correctChoiceId": "a",
            "explanation": "O verbo regular não foge do paradigma da sua conjugação."
          },
          {
            "id": "reg-q2",
            "type": "single-choice",
            "prompt": "Qual verbo é irregular?",
            "choices": [
              { "id": "a", "label": "amar" },
              { "id": "b", "label": "falar" },
              { "id": "c", "label": "fazer" }
            ],
            "correctChoiceId": "c",
            "explanation": "Fazer apresenta radicais diferentes: faço, fiz, farei."
          },
          {
            "id": "reg-q3",
            "type": "multiple-choice",
            "prompt": "Quais verbos são regulares?",
            "choices": [
              { "id": "a", "label": "falar" },
              { "id": "b", "label": "vender" },
              { "id": "c", "label": "ser" },
              { "id": "d", "label": "partir" }
            ],
            "correctChoiceIds": ["a", "b", "d"],
            "explanation": "Ser é irregular (sou, era, fui); os demais seguem seus modelos."
          }
        ]
      }
    },
    {
      "id": "verbos-defectivos-anomalos",
      "title": "Defectivos e Anômalos",
      "subtitle": "Conjugação incompleta e radicais múltiplos",
      "chapter": "Módulo 02 · Conjugação",
      "icon": "star",
      "position": { "x": 0, "y": 1 },
      "unlock": { "requires": ["verbos-regulares-irregulares"] },
      "npc": {
        "speaker": "Guardiã das Formas",
        "lines": [
          "Alguns verbos têm buracos na conjugação.",
          "Outros trocam de radical no meio do caminho."
        ]
      },
      "reward": { "itemId": "chave-defectiva", "label": "Chave dos defectivos" },
      "lesson": {
        "id": "lesson-verbos-defectivos-anomalos",
        "title": "Verbos defectivos e anômalos",
        "intro": "Defectivos não se conjugam em todas as formas. Anômalos apresentam mais de um radical.",
        "xpReward": 50,
        "coinReward": 14,
        "requiredCorrectRatio": 1,
        "questions": [
          {
            "id": "def-q1",
            "type": "single-choice",
            "prompt": "O que é um verbo defectivo?",
            "choices": [
              { "id": "a", "label": "Não se conjuga em todas as pessoas ou formas." },
              { "id": "b", "label": "Tem duas formas equivalentes." },
              { "id": "c", "label": "Substitui outro verbo na frase." }
            ],
            "correctChoiceId": "a",
            "explanation": "O defectivo tem lacunas na conjugação."
          },
          {
            "id": "def-q2",
            "type": "single-choice",
            "prompt": "Qual verbo é defectivo?",
            "choices": [
              { "id": "a", "label": "falar" },
              { "id": "b", "label": "falir" },
              { "id": "c", "label": "amar" }
            ],
            "correctChoiceId": "b",
            "explanation": "Falir só se usa nas formas arrizotônicas, como falimos e falem."
          },
          {
            "id": "def-q3",
            "type": "single-choice",
            "prompt": "O que é um verbo anômalo?",
            "choices": [
              { "id": "a", "label": "Apresenta mais de um radical ao longo da conjugação, como ser e ir." },
              { "id": "b", "label": "Segue sempre o modelo regular." },
              { "id": "c", "label": "Não possui sujeito." }
            ],
            "correctChoiceId": "a",
            "explanation": "Ser (sou/era/fui) e ir (vou/fui/ia) são exemplos clássicos de anomalia."
          }
        ]
      }
    },
    {
      "id": "verbos-abundantes-pronominais",
